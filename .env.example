# No navegador, este endereço aponta para o backend abaixo.
# Na publicação, troque pelo endereço HTTPS do backend hospedado.
EXPO_PUBLIC_PLATE_API_URL=http://localhost:3001/api/vehicles
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Usado apenas pelo backend. Nunca use prefixo EXPO_PUBLIC_ para o token.
FALCON_API_TOKEN=
API_PORT=3001
# Origens permitidas separadas por vírgula; inclua o domínio do site publicado.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Autenticação e RBAC (apenas backend; NUNCA usar prefixo EXPO_PUBLIC_ para segredos)
# Obrigatório em produção (NODE_ENV=production) com no mínimo 32 caracteres.
AUTH_JWT_SECRET=
AUTH_DB_PATH=./data/torquelab.sqlite
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Seed opcional do administrador inicial (apenas backend)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
