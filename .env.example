# ==============================================================================
# Frontend (Expo Web) — variáveis públicas embutidas no bundle
# ==============================================================================
# Produção na Vercel / Docker (same-origin):
EXPO_PUBLIC_API_BASE_URL=same-origin
EXPO_PUBLIC_PLATE_API_URL=/api/vehicles

# Desenvolvimento local separado (Expo em :8081 + API em :3001):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# EXPO_PUBLIC_PLATE_API_URL=http://localhost:3001/api/vehicles

# ==============================================================================
# Backend / Serverless (NUNCA usar prefixo EXPO_PUBLIC_ para segredos)
# ==============================================================================
# Banco Turso / libSQL (obrigatório na Vercel em produção):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Usado apenas pelo backend. Nunca use prefixo EXPO_PUBLIC_ para o token.
FALCON_API_TOKEN=
API_PORT=3001
# Origens permitidas separadas por vírgula (para chamadas cross-origin em dev/preview).
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://127.0.0.1:8081

# Autenticação e RBAC (apenas backend; NUNCA usar prefixo EXPO_PUBLIC_ para segredos)
# Obrigatório em produção (NODE_ENV=production) com no mínimo 32 caracteres.
AUTH_JWT_SECRET=
# Banco SQLite local (usado em dev/Docker quando TURSO_DATABASE_URL não está definida)
AUTH_DB_PATH=./data/torquelab.sqlite
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

# Seed opcional do administrador inicial (apenas backend)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
